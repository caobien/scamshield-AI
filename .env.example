# ─── Required ───────────────────────────────────────────────────────────────

# Google Gemini API Key (server-side only — NEVER exposed to browser)
# Obtain from: https://aistudio.google.com/app/apikey
# On Cloud Run: inject via Secret Manager, not environment variable directly.
GEMINI_API_KEY="your_gemini_api_key_here"

# ─── Optional: Gemini Model Configuration ────────────────────────────────────

# Gemini model name. Default: gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash

# Gemini API call timeout in milliseconds. Default: 30000 (30 seconds)
# GEMINI_TIMEOUT_MS=30000

# Max number of retries for transient errors (429/503/network). Default: 3
# GEMINI_MAX_RETRIES=3

# ─── Optional: Rate Limiting ─────────────────────────────────────────────────

# Rate limit window in milliseconds. Default: 60000 (1 minute)
# RATE_LIMIT_WINDOW_MS=60000

# Max requests per IP per window. Default: 20
# RATE_LIMIT_MAX=20

# Max concurrent Gemini API calls (cost protection). Default: 5
# MAX_CONCURRENT_GEMINI=5

# ─── Optional: Input Limits ───────────────────────────────────────────────────

# Max message/URL text length in characters. Default: 2000
# MAX_MESSAGE_CHARS=2000
# MAX_URL_CHARS=2000

# Max image file size in bytes. Default: 10485760 (10MB)
# MAX_IMAGE_BYTES=10485760

# ─── Optional: Server ────────────────────────────────────────────────────────

# Server port. Cloud Run injects this automatically. Default: 3000
# PORT=3000

# ─── Optional: Application URL ───────────────────────────────────────────────

# Canonical URL where the app is hosted (for Cloud Run, set automatically)
# APP_URL=https://your-service-url.run.app
